# Copie ce fichier en ".env" et remplis avec TES valeurs.
# Le vrai ".env" ne doit JAMAIS être commité (voir .gitignore).

# Token donné par @BotFather sur Telegram
TELEGRAM_TOKEN=colle_ton_token_ici

# Ton ID de chat Telegram (un nombre). Obtenu via @userinfobot
CHAT_ID_ALERTE=123456789

# Nom affiché dans les messages (libre, garde-le générique si tu veux rester discret)
SERVER_NAME=Serveur

# Conteneurs à surveiller, séparés par des virgules
CONTENEURS_A_SURVEILLER=service_a,service_b,service_c

# Intervalle de vérification en secondes
INTERVALLE_CHECK=60
